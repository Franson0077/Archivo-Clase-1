# Proveedor principal y de respaldo (si el principal se cae, se usa el otro).
LLM_PROVIDER=anthropic
LLM_FALLBACK_PROVIDER=openai

ANTHROPIC_API_KEY=tu_clave_anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=tu_clave_openai
OPENAI_MODEL=gpt-4o-mini

# Opcionales: reintentos del SDK antes de pasar al respaldo y timeout en segundos.
LLM_MAX_RETRIES=2
LLM_TIMEOUT=60
